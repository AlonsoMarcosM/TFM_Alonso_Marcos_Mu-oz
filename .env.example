# Copia este archivo como `.env` y rellena los valores locales.
# `.env` esta ignorado por Git y no debe versionarse.

# GitHub Project v2 del TFM.
GITHUB_OWNER=AlonsoMarcosM
GITHUB_REPO=TFM_Alonso_Marcos_Mu-oz
GITHUB_PROJECT_NUMBER=6

# Rellena solo uno de los dos. No subas nunca tokens al repositorio.
GITHUB_TOKEN=
GH_TOKEN=

# OpenMetadata local de la PoC. El token se puede generar con scripts/infra/generate_om_jwt.py.
OPENMETADATA_BASE_URL=http://localhost:8585/api/v1
OPENMETADATA_TOKEN=

# Rutas operativas opcionales.
TFM_OPERATIONAL_PROFILE=tfm_ingestor/config/operational_profile.yaml
TFM_GOVERNANCE_SHEET=tfm_ingestor/config/gold_governance.csv
